{
    "name":  "taskflow-server",
    "version":  "1.0.0",
    "description":  "TaskFlow Project Management REST API",
    "main":  "src/app.js",
    "scripts":  {
                    "postinstall":  "prisma generate",
                    "start":  "prisma db push --accept-data-loss && node server/src/app.js",
                    "dev":  "nodemon server/src/app.js",
                    "db:push":  "prisma db push",
                    "db:generate":  "prisma generate",
                    "db:studio":  "prisma studio"
                },
    "dependencies":  {
                         "@prisma/client":  "^7.8.0",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.1",
                         "express":  "^4.18.2",
                         "jsonwebtoken":  "^9.0.2",
                         "prisma":  "^7.8.0"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.0.3"
                        },
    "engines":  {
                    "node":  "\u003e=20.19.0"
                }
}
