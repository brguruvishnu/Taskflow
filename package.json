{
  "name": "taskflow-server",
  "version": "1.0.0",
  "description": "TaskFlow Project Management REST API",
  "main": "src/app.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "npx prisma db push --accept-data-loss && node server/src/app.js",
    "dev": "nodemon server/src/app.js",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "prisma": "^5.10.0"
  }
}
